# ══════════════════════════════════════════════════════════════════════════════
# ArmPilot-AI — Environment Variables
# Copy to .env and modify as needed.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────────
ARMPILOT_HOST=0.0.0.0
ARMPILOT_PORT=8000
ARMPILOT_DEBUG=false
ARMPILOT_LOG_LEVEL=INFO
ARMPILOT_CORS_ORIGINS=["*"]

# ── Paths ───────────────────────────────────────────────────────────────────
ARMPILOT_MODELS_DIR=models
ARMPILOT_DATA_DIR=data
ARMPILOT_REPORTS_DIR=reports

# ── Inference ───────────────────────────────────────────────────────────────
ARMPILOT_DEFAULT_RUNTIME=llama.cpp
ARMPILOT_DEFAULT_THREADS=4
ARMPILOT_DEFAULT_BATCH_SIZE=512
ARMPILOT_DEFAULT_CONTEXT_LENGTH=2048
ARMPILOT_MAX_TOKENS_DEFAULT=256
ARMPILOT_GPU_LAYERS=0

# ── Benchmark ───────────────────────────────────────────────────────────────
ARMPILOT_BENCHMARK_DURATION_DEFAULT=60
ARMPILOT_BENCHMARK_CONCURRENCY_DEFAULT=1
ARMPILOT_BENCHMARK_WARMUP_REQUESTS=3

# ── Database (if using persistence) ────────────────────────────────────────
# ARMPILOT_DATABASE_URL=sqlite:///data/arm.db

# ── Docker ──────────────────────────────────────────────────────────────────
# COMPOSE_PROJECT_NAME=armpilot
